# Conexão com o banco Postgres `fiap` (preencher em .env, nunca commitar)
FIAP_DB_HOST=
FIAP_DB_PORT=5432
FIAP_DB_USER=
FIAP_DB_PASSWORD=
FIAP_DB_NAME=fiap

# Schema onde vive o modelo dimensional (dim_*, fct_*) dentro do banco fiap
FIAP_DW_SCHEMA=dw

# API (app/api)
API_CORS_ORIGINS=http://localhost:5173

# Web (app/web) — URL da API consumida pelo React em dev
VITE_API_BASE_URL=http://localhost:8000
